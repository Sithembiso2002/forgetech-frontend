generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      Role     @default(EDITOR)
  fullName  String?
  createdAt DateTime @default(now())
}

model Service {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  icon             String
  shortDescription String            @map("shortDescription")
  description      String
  benefits         String[]
  technologies     String[]
  industries       String[]
  process          String[]
  order            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  heroImage        String?
  secondaryImage   String?
  testimonial      Json?
  HomepageService  HomepageService[]
  Project          Project[]
  SubService       SubService[]
}

model SubService {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  description String
  benefit     String
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  client       String?
  industry     String
  overview     String
  objectives   String[]
  features     String[]
  technologies String[]
  results      String
  featured     Boolean  @default(false)
  mainImage    String?
  screenshots  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id], onUpdate: NoAction)
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  readingTime String?
}

model NewsItem {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  summary          String
  content          String
  image            String?
  published        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  readingTime      String?
  HomepageNewsItem HomepageNewsItem[]
}

model Vacancy {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  department   String
  location     String
  type         String
  description  String
  requirements String[]
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id          String   @id @default(uuid())
  vacancyId   String
  fullName    String
  email       String
  phone       String?
  resumeUrl   String
  coverLetter String?
  status      String   @default("submitted")
  createdAt   DateTime @default(now())
  vacancy     Vacancy  @relation(fields: [vacancyId], references: [id])
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String
  photoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  company    String?
  content    String
  avatarUrl  String?
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Media {
  id        String   @id @default(uuid())
  fileName  String
  url       String
  altText   String?
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  name             String
  email            String
  phone            String?
  enquiryType      String
  service          String?
  message          String
  createdAt        DateTime @default(now())
  budget           String?
  attachmentBase64 String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model NewsletterSubscription {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  email        String   @unique
  subscribedAt DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model HomepageService {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  serviceId        String
  title            String?
  shortDescription String?
  description      String?
  features         String[]
  image1           String?
  image2           String?
  cta              String?
  order            Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @db.Timestamp(6)
  Service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model HomepageNewsItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  newsItemId    String
  customImage   String?
  customSummary String?
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamp(6)
  newsItem      NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum Role {
  ADMIN
  EDITOR
}
